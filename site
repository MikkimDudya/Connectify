<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Социальная сеть знакомств</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f4;
            margin: 0;
            padding: 20px;
        }
        .form-container {
            background-color: white;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0px 0px 20px rgba(0, 0, 0, 0.1);
            width: 350px;
            margin: 0 auto;
        }
        input, textarea, button {
            width: 100%;
            padding: 10px;
            margin: 10px 0;
            border: 1px solid #ccc;
            border-radius: 5px;
        }
        .birthday {
            background-color: rgba(255, 255, 255, 0.2); /* Полупрозрачный фон для даты */
            color: #ccc; /* Бледный цвет текста */
        }
        button {
            background-color: #007BFF;
            color: white;
            border: none;
            cursor: pointer;
        }
        button:hover {
            background-color: #0056b3;
        }
    </style>
</head>
<body>
    <div class="form-container">
        <h2>Регистрация</h2>
        <form id="registration-form">
            <input type="text" id="name" placeholder="Ваше имя" required>
            <input type="date" class="birthday" id="birthday" required>
            <input type="text" id="interests" placeholder="Ваши интересы" required>
            <textarea id="hobbies" placeholder="Ваши хобби" required></textarea>
            <button type="submit">Зарегистрироваться</button>
        </form>
    </div>

    <script>
        document.getElementById('registration-form').addEventListener('submit', function(e) {
            e.preventDefault();
            let name = document.getElementById('name').value;
            let birthday = document.getElementById('birthday').value;
            let interests = document.getElementById('interests').value;
            let hobbies = document.getElementById('hobbies').value;

            alert(`Здравствуйте, ${name}! Ваши данные сохранены.`);
            console.log("Данные пользователя:", { name, birthday, interests, hobbies });
        });
    </script>
</body>
</html>
